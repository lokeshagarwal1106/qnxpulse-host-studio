# CMake Cross-Compilation Toolchain for QNX Neutrino RTOS 8.0
set(CMAKE_SYSTEM_NAME QNX)
set(CMAKE_SYSTEM_VERSION 8.0.0)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

if(DEFINED ENV{QNX_HOST})
  set(CMAKE_C_COMPILER "$ENV{QNX_HOST}/usr/bin/qcc")
  set(CMAKE_CXX_COMPILER "$ENV{QNX_HOST}/usr/bin/q++")
else()
  set(CMAKE_C_COMPILER qcc)
  set(CMAKE_CXX_COMPILER q++)
endif()

set(CMAKE_C_FLAGS_INIT "-Vgcc_ntox86_64 -O2 -Wall")
set(CMAKE_CXX_FLAGS_INIT "-Vgcc_ntox86_64_cxx -O2 -Wall")
set(CMAKE_FIND_ROOT_PATH "$ENV{QNX_TARGET}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
